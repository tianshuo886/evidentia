{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/agent_task.schema.json",
  "type": "object",
  "required": [
    "task_id",
    "task_type",
    "required_capability",
    "input_artifacts",
    "output_schema",
    "scientific_contract",
    "source_sha256"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "enum": [
        "OPEN_READING",
        "LENS",
        "RECONCILIATION",
        "VERIFICATION",
        "APPLY_LOCAL",
        "MEMORY_SYNTHESIS",
        "CROSS_PAPER_RELATION",
        "COUNCIL_CHAIR",
        "CROSS_EXAMINATION",
        "LEAD_READING",
        "LENS_V3",
        "REVISION_MEMO",
        "NARRATIVE_PLAN",
        "LEAD_WRITING",
        "VISUAL_LOCALIZATION",
        "DIRECT_READING_BASELINE",
        "READER_EVALUATION"
      ]
    },
    "lens": {
      "type": "string",
      "minLength": 1
    },
    "required_capability": {
      "type": "string"
    },
    "input_artifacts": {
      "type": "object"
    },
    "localized_evidence": {
      "type": [
        "object",
        "array"
      ]
    },
    "target_output": {
      "type": "string"
    },
    "output_schema": {
      "type": "string"
    },
    "scientific_contract": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "prohibited_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executor_template": {
      "type": "object"
    },
    "isolation_proof_required": {
      "type": "boolean"
    },
    "source_pdf": {
      "type": "string"
    },
    "base_model": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "base_model_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "lens_contract_version": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "challenger_lens": {
      "type": [
        "string",
        "null"
      ]
    },
    "statement": {
      "type": "string"
    },
    "allowed_verdicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_id": {
      "type": "string"
    },
    "project_doc": {
      "type": "string"
    },
    "frozen_paper_model": {
      "type": "string"
    },
    "manifest": {
      "type": "string"
    },
    "local_delta_sha256": {
      "type": "string"
    },
    "memory_bundle": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "base_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_package_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_version": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "lens_kind": {
      "enum": [
        "core",
        "specialist"
      ]
    },
    "paper_type": {
      "type": "string"
    },
    "selection_reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

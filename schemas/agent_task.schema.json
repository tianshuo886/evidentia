{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/agent_task.schema.json",
  "type": "object",
  "required": [
    "task_id",
    "task_type",
    "required_capability",
    "input_artifacts",
    "output_schema",
    "scientific_contract",
    "source_sha256"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "enum": [
        "OPEN_READING",
        "LENS",
        "RECONCILIATION",
        "VERIFICATION",
        "APPLY_LOCAL",
        "MEMORY_SYNTHESIS",
        "CROSS_PAPER_RELATION"
      ]
    },
    "lens": {
      "enum": [
        "author",
        "reviewer",
        "mechanism",
        "builder",
        "anomaly",
        "counterfactual"
      ]
    },
    "required_capability": {
      "type": "string"
    },
    "input_artifacts": {
      "type": "object"
    },
    "localized_evidence": {
      "type": ["object", "array"]
    },
    "target_output": {
      "type": "string"
    },
    "output_schema": {
      "type": "string"
    },
    "scientific_contract": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "prohibited_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executor_template": {
      "type": "object"
    },
    "source_pdf": {
      "type": "string"
    },
    "base_model": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "base_model_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "lens_contract_version": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "allowed_verdicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_id": {
      "type": "string"
    },
    "project_doc": {
      "type": "string"
    },
    "frozen_paper_model": {
      "type": "string"
    },
    "manifest": {
      "type": "string"
    },
    "local_delta_sha256": {
      "type": "string"
    },
    "memory_bundle": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "base_sha256": {
      "type": ["string", "null"]
    },
    "contract_version": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

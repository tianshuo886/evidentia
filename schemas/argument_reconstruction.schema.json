{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/argument_reconstruction.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "source_sha256",
    "central_question",
    "central_thesis",
    "argument_units",
    "argument_relations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "2.0"]
    },
    "paper_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "central_question": {
      "type": "string",
      "minLength": 1
    },
    "motivation": {
      "type": "string"
    },
    "prior_assumptions_or_gap": {
      "type": "string"
    },
    "central_thesis": {
      "type": "string",
      "minLength": 1
    },
    "story_spine": {
      "type": "object",
      "description": "Paper-centric semantic spine used by narrative composition. Missing source support stays explicit.",
      "properties": {
        "central_question": { "type": "string" },
        "motivation": { "type": "string" },
        "prior_gap": { "type": "string" },
        "central_move": { "type": "string" },
        "method_logic": { "type": "string" },
        "experimental_questions": { "type": "array", "items": { "type": "string" } },
        "major_findings": { "type": "array", "items": { "type": "string" } },
        "justified_conclusion": { "type": "string" },
        "scope_and_limits": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "turning_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "author_argument": {
      "type": "object",
      "properties": {
        "thesis": { "type": "string" },
        "progression": {
          "type": "array",
          "items": { "type": "string" }
        },
        "intended_interpretations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "assessed_argument": {
      "type": "object",
      "properties": {
        "justified_thesis": { "type": "string" },
        "supported_units": {
          "type": "array",
          "items": { "type": "string" }
        },
        "weakened_units": {
          "type": "array",
          "items": { "type": "string" }
        },
        "alternative_explanations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "epistemic_assessment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence_promotion": {
      "type": "object",
      "properties": {
        "narrative_core": {
          "type": "array",
          "items": { "type": "string" }
        },
        "narrative_support": {
          "type": "array",
          "items": { "type": "string" }
        },
        "audit_only": {
          "type": "array",
          "items": { "type": "string" }
        },
        "uncertain": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_roles": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["narrative_core", "narrative_support", "audit_only", "uncertain"]
          }
        }
      },
      "additionalProperties": false
    },
    "argument_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "semantic_role",
          "proposition",
          "explanatory_narrative"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ARG-[0-9]{2,}$"
          },
          "semantic_role": {
            "type": "string",
            "enum": [
              "problem",
              "premise",
              "hypothesis",
              "method_rationale",
              "observation",
              "result",
              "interpretation",
              "conclusion",
              "limitation",
              "alternative_explanation"
            ]
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "explanatory_narrative": {
            "type": "string",
            "minLength": 1
          },
          "source_anchors": {
            "type": "array",
            "items": { "type": "string" }
          },
          "linked_claim_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "linked_evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "epistemic_status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "SUPPORTED",
              "PARTIAL",
              "UNCERTAIN",
              "CONTRADICTED",
              "HYPOTHETICAL",
              "ASSUMED",
              "INSUFFICIENT_EVIDENCE"
            ]
          },
          "confidence": {
            "type": "string"
          },
          "provenance": {
            "type": ["string", "object"]
          },
          "predecessor_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "successor_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "argument_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from_unit",
          "to_unit",
          "relation_type",
          "origin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REL-[0-9]{2,}$"
          },
          "from_unit": {
            "type": "string"
          },
          "to_unit": {
            "type": "string"
          },
          "relation_type": {
            "type": "string",
            "enum": [
              "motivates",
              "addresses",
              "tests",
              "supports",
              "weakens",
              "qualifies",
              "contradicts",
              "explains",
              "depends_on",
              "rules_out",
              "leaves_open"
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "author",
              "evidentia_assessment"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

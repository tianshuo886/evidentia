{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/equation.schema.json",
  "type": "object",
  "required": [
    "equation_id",
    "page",
    "raw_text"
  ],
  "properties": {
    "equation_id": {
      "type": "string"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "source_page": {
      "type": "integer",
      "minimum": 1
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "raw_text": {
      "type": "string"
    },
    "latex": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_mode": { "type": "boolean" },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "meaning_zh"],
        "properties": {
          "symbol": { "type": "string" },
          "meaning_zh": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "role_zh": { "type": "string" },
    "source_confidence": { "enum": ["VERIFIED", "UNCERTAIN", "AMBIGUOUS", "NOT_STATED"] },
    "fallback_asset": { "type": ["string", "null"] },
    "surrounding_text": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "referenced_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "used_by_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}

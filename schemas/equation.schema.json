{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/equation.schema.json",
  "type": "object",
  "required": [
    "equation_id",
    "page",
    "raw_text"
  ],
  "properties": {
    "equation_id": {
      "type": "string"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "source_page": {
      "type": "integer",
      "minimum": 1
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "raw_text": {
      "type": "string"
    },
    "latex": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_mode": { "type": "boolean" },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "meaning_zh"],
        "properties": {
          "symbol": { "type": "string" },
          "meaning_zh": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "role_zh": { "type": "string" },
    "source_confidence": { "enum": ["VERIFIED", "UNCERTAIN", "AMBIGUOUS", "NOT_STATED"] },
    "fallback_asset": { "type": ["string", "null"] },
    "surrounding_text": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "referenced_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "used_by_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "paper_label": {
      "type": ["string", "null"]
    },
    "equation_number": {
      "type": ["integer", "null"]
    },
    "explanation": {
      "type": "string"
    },
    "verification_receipt": {
      "type": ["object", "null"]
    },
    "pedagogy": {
      "type": ["object", "null"],
      "properties": {
        "role": { "type": "string" },
        "explanation_priority": { "enum": ["MUST_EXPLAIN", "CONCISE_DEFINE", "AUDIT_ONLY"] },
        "symbol_definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["symbol", "interpretation"],
            "properties": {
              "symbol": { "type": "string" },
              "name": { "type": "string" },
              "interpretation": { "type": "string" },
              "dimension": { "type": "string" },
              "domain": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "input_output": {
          "type": "object",
          "properties": {
            "inputs": { "type": "array", "items": { "type": "string" } },
            "outputs": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "term_interpretations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["term", "intuition"],
            "properties": {
              "term": { "type": "string" },
              "role": { "type": "string" },
              "intuition": { "type": "string" },
              "effect": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "implementation_proxy": {
          "type": ["string", "null"]
        },
        "source_anchors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unspecified_details": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

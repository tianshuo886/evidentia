{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/execution_receipt.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "accepted_at",
    "execution_id",
    "dispatch_sha256",
    "task_id",
    "task_sha256",
    "code_sha",
    "input_hashes",
    "output_sha256",
    "envelope_sha256",
    "target_output",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "accepted_at": {"type": "string", "minLength": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "dispatch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_sha": {"type": "string", "minLength": 1},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_output": {"type": "string", "minLength": 1},
    "executor": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

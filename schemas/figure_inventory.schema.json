{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tianshuo886/evidentia/blob/main/schemas/figure_inventory.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "pdf": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "figure",
              "table"
            ]
          },
          "paper_label": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "caption_original": {
            "type": [
              "string",
              "null"
            ]
          },
          "caption_status": {
            "enum": [
              "OK",
              "NOT_EXTRACTED"
            ]
          },
          "role": {
            "enum": [
              "unassigned",
              "critical",
              "supporting",
              "context",
              "diagnostic"
            ]
          },
          "depth": {
            "enum": [
              "unassigned",
              "deep",
              "normal",
              "light"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "caption_bbox": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "subfigures": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "extraction_method": {
            "enum": [
              "page_crop",
              "embedded",
              "manual",
              "none"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "inspection": {
            "type": "string"
          },
          "binding_method": {
            "enum": [
              "embedded",
              "page_crop",
              "manual",
              "none",
              "caption_geometry"
            ]
          },
          "binding_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needs_visual_review": {
            "type": "boolean"
          },
          "source_location": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "paper_label",
          "page",
          "caption_original",
          "caption_status",
          "role",
          "depth",
          "file",
          "inspection"
        ],
        "additionalProperties": false
      }
    },
    "unmatched_assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_sha256": {
      "type": "string",
      "minLength": 1
    },
    "embedded_saved": {
      "type": "integer"
    }
  },
  "required": [
    "items",
    "pages",
    "pdf",
    "review_required",
    "schema_version",
    "source_sha256",
    "unmatched_assets"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tianshuo886/evidentia/blob/main/schemas/lens.schema.json",
  "type": "object",
  "properties": {
    "lens": {
      "enum": [
        "author",
        "reviewer",
        "mechanism",
        "builder",
        "anomaly",
        "counterfactual"
      ]
    },
    "base_sha256": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L-(author|reviewer|mechanism|builder|anomaly|counterfactual)-[0-9]{2,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "epistemic": {
            "enum": [
              "VERIFIED",
              "SUPPORTED",
              "PARTIAL",
              "NOT_STATED",
              "AMBIGUOUS",
              "INSUFFICIENT_EVIDENCE",
              "MODEL_UNCERTAIN",
              "NEEDS_SUPPLEMENT",
              "NEEDS_CITATION_TRACE",
              "UNRESOLVED"
            ]
          },
          "novel_vs_base": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "statement",
          "evidence",
          "epistemic",
          "novel_vs_base"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "lens_contract_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": "object"
    },
    "base_model_sha256": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "lens",
    "source_sha256",
    "base_sha256",
    "base_model_sha256",
    "lens_contract_version",
    "prompt_version",
    "findings",
    "notes"
  ],
  "additionalProperties": false
}

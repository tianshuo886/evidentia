{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/lens_reconciliation.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "source_sha256",
    "base_model_sha256",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_sha256": {
      "type": "string",
      "minLength": 1
    },
    "base_model_sha256": {
      "type": "string",
      "minLength": 1
    },
    "base_sha256": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status",
          "supporting_lenses",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "AGREEMENT",
              "COMPLEMENTARY",
              "PARTIAL_AGREEMENT",
              "TENSION",
              "CONTRADICTION",
              "ORTHOGONAL",
              "UNRESOLVED",
              "MODEL_SINGLETON",
              "CROSS_MODEL_CONVERGENCE",
              "CONSENSUS"
            ]
          },
          "supporting_lenses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflict_note": {
            "type": "string"
          },
          "cluster_id": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relation": {
            "enum": [
              "AGREEMENT",
              "COMPLEMENTARY",
              "PARTIAL_AGREEMENT",
              "TENSION",
              "CONTRADICTION",
              "ORTHOGONAL",
              "UNRESOLVED"
            ]
          },
          "canonical_statement": {
            "type": "string"
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "epistemic_state": {
            "type": "string"
          },
          "requires_verification": {
            "type": "boolean"
          },
          "verifier_status": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/narrative_manuscript.schema.json",
  "title": "Open paper-specific Reader manuscript",
  "type": "object",
  "required": ["schema_version", "paper_id", "source_sha256", "created_at", "document"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0", "2.0", "3.0"] },
    "paper_id": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "narrative_plan_ref": { "type": "string" },
    "document": {
      "type": "object",
      "required": ["title", "paper_meta"],
      "anyOf": [{ "required": ["sections"] }, { "required": ["chapters"] }],
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "paper_meta": {
          "type": "object",
          "properties": {
            "authors": { "type": "array", "items": { "type": "string" } },
            "venue": { "type": "string" },
            "year": { "type": ["integer", "string", "null"] },
            "doi": { "type": "string" },
            "pdf_sha256": { "type": "string" }
          },
          "additionalProperties": true
        },
        "orientation": {
          "type": "object",
          "properties": {
            "lead": { "type": "string" },
            "takeaways": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "executive_summary": {
          "type": "object",
          "properties": {
            "lead": { "type": "string" },
            "takeaways": { "type": "array", "items": { "type": "string" } },
            "key_question": { "type": "string" },
            "core_finding": { "type": "string" },
            "core_boundary": { "type": "string" }
          },
          "required": ["lead", "takeaways"],
          "additionalProperties": true
        },
        "narrative_plan": { "$ref": "#/$defs/plan" },
        "story_spine": {
          "type": "object",
          "description": "Optional read-only compatibility metadata. It is never used to order or validate sections.",
          "additionalProperties": true
        },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
        "chapters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
        "appendix_summary": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  },
  "allOf": [{
    "if": {"properties": {"schema_version": {"const": "3.0"}}},
    "then": {"anyOf": [{"required": ["narrative_plan_ref"]}, {"properties": {"document": {"required": ["narrative_plan"]}}}]}
  }],
  "$defs": {
    "plan": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "schema_version": { "type": "string" },
        "paper_id": { "type": "string" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/plan_section" } }
      },
      "additionalProperties": true
    },
    "plan_section": {
      "type": "object",
      "required": ["id", "title", "purpose", "evidence_refs", "source_anchors"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string" },
        "proposition": { "type": "string" },
        "question": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "source_anchors": { "type": "array", "items": { "type": "string" } },
        "bindings": { "type": "array", "items": { "type": "string" } },
        "argument_refs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "chapter_num": { "type": ["string", "integer"] },
        "title": { "type": "string" },
        "lead": { "type": "string" },
        "purpose": { "type": "string" },
        "proposition": { "type": "string" },
        "question": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "source_anchors": { "type": "array", "items": { "type": "string" } },
        "bindings": { "type": "array", "items": { "type": "string" } },
        "argument_refs": { "type": "array", "items": { "type": "string" } },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      },
      "additionalProperties": true
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["paragraph", "callout", "figure", "equation", "table", "takeaway", "list"] },
        "text": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "argument_refs": { "type": "array", "items": { "type": "string" } },
        "source_anchors": { "type": "array", "items": { "type": "string" } },
        "evidence_id": { "type": "string" },
        "caption": { "type": "string" },
        "analysis": { "type": "string" },
        "question": { "type": "string" },
        "supports": { "type": "array", "items": { "type": "string" } },
        "limits": { "type": "array", "items": { "type": "string" } },
        "presentation_role": { "type": "string", "enum": ["narrative_core", "narrative_support", "audit_only", "uncertain"] },
        "explanation": { "type": "string" },
        "raw_text": { "type": "string" },
        "asset": { "type": ["string", "null"] },
        "fallback_asset": { "type": ["string", "null"] },
        "page": { "type": "integer" },
        "items": { "type": "array", "items": { "type": "string" } },
        "latex": { "type": ["string", "null"] },
        "source_confidence": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}

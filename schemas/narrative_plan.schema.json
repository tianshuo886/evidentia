{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/narrative_plan.schema.json",
  "title": "Paper-specific narrative plan",
  "type": "object",
  "required": ["schema_version", "paper_id", "source_sha256", "sections"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "paper_id": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "minLength": 1 },
    "paper_characterization": { "type": "string" },
    "rationale": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose", "evidence_refs", "source_anchors"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string" },
          "proposition": { "type": "string" },
          "question": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "source_anchors": { "type": "array", "items": { "type": "string" } },
          "bindings": { "type": "array", "items": { "type": "string" } },
          "argument_refs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "uncertainties": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}

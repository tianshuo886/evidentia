{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/open_reading_manifest.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "source_sha256",
    "base_model_sha256",
    "lens_contract_version",
    "prompt_version",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_sha256": {
      "type": "string",
      "minLength": 1
    },
    "base_model_sha256": {
      "type": "string",
      "minLength": 1
    },
    "lens_contract_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "object"
    },
    "created_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

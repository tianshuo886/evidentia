{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/paper_argument_topology.schema.json",
  "title": "Open paper-specific argument topology",
  "type": "object",
  "required": ["schema_version", "paper_id", "source_sha256", "nodes", "relations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "paper_id": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "minLength": 1 },
    "characterization": { "type": "string" },
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "proposition", "evidence_refs", "source_anchors", "epistemic_status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "proposition": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "source_anchors": { "type": "array", "items": { "type": "string" } },
          "epistemic_status": { "type": "string" },
          "observation": { "type": "string" },
          "author_interpretation": { "type": "string" },
          "evidentia_assessment": { "type": "string" }
        },
        "additionalProperties": true,
        "anyOf": [
          { "properties": { "evidence_refs": { "minItems": 1 } } },
          { "properties": { "source_anchors": { "minItems": 1 } } }
        ]
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation", "origin"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "origin": { "enum": ["author", "evidentia_assessment"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "source_anchors": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "ordering": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}

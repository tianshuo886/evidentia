{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/paper_understanding_draft.schema.json",
  "title": "Open-form Lead Reader comprehension draft",
  "type": "object",
  "required": ["schema_version", "paper_id", "source_sha256", "paper_type", "structure_characterization", "argument_topology", "narrative", "decisive_evidence", "uncertainties"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "paper_id": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "minLength": 1 },
    "paper_type": { "type": "string", "minLength": 1 },
    "paper_characterization": { "type": "string", "minLength": 1 },
    "structure_characterization": { "type": "string", "minLength": 1 },
    "argument_topology": {
      "type": "object",
      "description": "Dynamic source-grounded nodes and relations; no role set is mandatory.",
      "required": ["nodes", "relations"],
      "properties": {
        "characterization": { "type": "string" },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "ordering": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "story_spine": {
      "type": "object",
      "description": "Optional compatibility metadata only. It is not a required comprehension schema.",
      "additionalProperties": true
    },
    "narrative": { "type": "string", "minLength": 200 },
    "decisive_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "open_issues": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "proposition", "source_anchors", "evidence_refs", "epistemic_status"],
      "anyOf": [{"properties": {"source_anchors": {"minItems": 1}}}, {"properties": {"evidence_refs": {"minItems": 1}}}],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "minLength": 1 },
        "semantic_role": { "type": "string" },
        "proposition": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "source_anchors": { "type": "array", "items": { "type": "string" } },
        "epistemic_status": { "type": "string", "enum": ["VERIFIED", "SUPPORTED", "PARTIAL", "CONTRADICTED", "HYPOTHETICAL", "ASSUMED", "UNCERTAIN", "NOT_STATED", "AMBIGUOUS", "INSUFFICIENT_EVIDENCE", "MODEL_UNCERTAIN", "UNRESOLVED"] },
        "observation": { "type": "string" },
        "author_interpretation": { "type": "string" },
        "evidentia_assessment": { "type": "string" }
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": ["from", "to", "relation"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "relation": { "type": "string", "minLength": 1 },
        "relation_type": { "type": "string" },
        "origin": { "enum": ["author", "evidentia_assessment"] },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "source_anchors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["evidence", "why_it_matters"],
      "properties": {
        "evidence": { "type": "array", "items": { "type": "string" } },
        "claim": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "does_not_establish": { "type": "string" },
        "source_anchors": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

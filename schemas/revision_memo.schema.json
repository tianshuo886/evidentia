{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/revision_memo.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "source_sha256",
    "summary",
    "revisions",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "paper_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "action",
          "instruction",
          "rationale",
          "evidence",
          "source_lenses"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "action": {
            "enum": [
              "ADD",
              "REWRITE",
              "CORRECT",
              "QUALIFY",
              "REMOVE",
              "VERIFY"
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_lenses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "evidence"
        ],
        "properties": {
          "issue": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

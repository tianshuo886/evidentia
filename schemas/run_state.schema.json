{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tianshuo886/evidentia/blob/main/schemas/run_state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "phase",
    "allowed_inputs",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "evidentia"
      ]
    },
    "phase": {
      "enum": [
        "INGEST",
        "SOURCE_RECONSTRUCTION",
        "SOURCE_LOCK",
        "OPEN_READING",
        "BASELINE_LOCK",
        "LENS",
        "FREEZE",
        "RENDER",
        "APPLY",
        "COMPLETE",
        "FAILED"
      ]
    },
    "allowed_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "status"
        ],
        "properties": {
          "phase": {
            "type": "string"
          },
          "status": {
            "enum": [
              "started",
              "completed",
              "failed"
            ]
          },
          "at": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "source_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_hashes": {
      "type": "object"
    },
    "executor": {
      "type": "object"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/run_state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "phase",
    "allowed_inputs",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "evidentia"
      ]
    },
    "phase": {
      "enum": [
        "INGEST",
        "SOURCE_RECONSTRUCTION",
        "SOURCE_LOCK",
        "OPEN_READING_TASK_READY",
        "WAITING_FOR_OPEN_READING_AGENT",
        "WAITING_FOR_AGENT",
        "OPEN_READING",
        "OPEN_READING_RECEIVED",
        "BASELINE_LOCK",
        "LENS_TASKS_READY",
        "WAITING_FOR_LENS_AGENTS",
        "LENS_EXECUTION",
        "LENS_EXECUTION_COMPLETE",
        "PRE_RECONCILIATION",
        "WAITING_FOR_RECONCILIATION_AGENT",
        "RECONCILIATION",
        "RECONCILIATION_COMPLETE",
        "VERIFICATION_TASKS_READY",
        "WAITING_FOR_VERIFIERS",
        "VERIFICATION",
        "VERIFICATION_COMPLETE",
        "FINAL_MODEL",
        "LENS",
        "FREEZE",
        "RENDER",
        "APPLY_INIT",
        "PROJECT_CONTEXT",
        "APPLY_LOCAL_TASK_READY",
        "WAITING_FOR_APPLY_AGENT",
        "LOCAL_DELTA",
        "CONTEXTUAL_REREAD",
        "DELTA_VALIDATION",
        "APPLY_COMPLETE",
        "APPLY",
        "OPTIONAL_MEMORY_RETRIEVAL",
        "MEMORY_SYNTHESIS_TASK_READY",
        "MEMORY_AUGMENTED_SYNTHESIS",
        "PROJECT_MEMORY_COMMIT",
        "COMPLETE",
        "FAILED"
      ]
    },
    "allowed_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "status"
        ],
        "properties": {
          "phase": {
            "type": "string"
          },
          "status": {
            "enum": [
              "started",
              "completed",
              "failed"
            ]
          },
          "at": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "source_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "lens_contract_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_hashes": {
      "type": "object"
    },
    "executor": {
      "type": "object"
    },
    "execution_kind": {
      "type": "string"
    },
    "validation_status": {
      "type": "string"
    }
  }
}

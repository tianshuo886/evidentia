{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidentia.dev/schemas/source_map.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "pdf_sha256": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "reading_order": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "equations": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "required": ["equation_id", "page", "raw_text"],
                  "properties": {
                    "equation_id": { "type": "string" },
                    "page": { "type": "integer" },
                    "raw_text": { "type": "string" },
                    "latex": { "type": ["string", "null"] },
                    "bbox": { "type": "array", "items": { "type": "number" } },
                    "surrounding_text": { "type": "string" },
                    "section": { "type": "string" },
                    "referenced_by": { "type": "array", "items": { "type": "string" } },
                    "confidence": { "type": "number" }
                  }
                }
              ]
            }
          },
          "mentions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "figure",
                    "table",
                    "equation"
                  ]
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "target_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "bound": {
                  "type": "boolean"
                }
              },
              "required": [
                "label",
                "kind",
                "bbox"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "number",
          "sections",
          "equations",
          "mentions"
        ],
        "additionalProperties": false
      }
    },
    "supplements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "pages": {
                "type": "integer"
              },
              "coverage_state": {
                "type": "string"
              },
              "page_anchors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "figure_table_inventory": {
                "type": "array"
              }
            }
          }
        ]
      }
    },
    "quality": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "pdf_sha256",
    "pages",
    "supplements"
  ],
  "additionalProperties": false
}
